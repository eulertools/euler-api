{
  "name": "euler-api",
  "version": "1.0.0",
  "description": "Euler API",
  "private": true,
  "config": {
    "unsafe-perm": true
  },
  "scripts": {
    "build": "npm run postinstall; npm run linkUtils; (tsc)",
    "build-local": "(tsc)",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "synth-template": "npm run build-local && cdk synth EulerMainStack --no-staging > template.yaml",
    "synth-EulerMainStack": "npm run build && cdk synth EulerMainStack",
    "synth-PipelineStack": "npm run build && cdk synth Pipelinebsc",
    "postinstall": "find ./src -type d -maxdepth 1 -exec sh -c \"test -f {}/package.json && cd {} && npm i\" \\;",
    "linkUtils": "bash scripts/linkUtils.sh",
    "clean": "npm run cleanModules && npm run cleanJS",
    "cleanJS": "find ./src -type f -name \"*.js\" -exec rm -f \"{}\" \\;",
    "cleanModules": "find ./src -type d -maxdepth 2 -name node_modules -exec rm -rf \"{}\" \\;"
  },
  "author": {
    "name": "mfcattafesta",
    "url": "https://euler-api.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.72",
    "@types/node": "10.17.27",
    "agentkeepalive": "^4.1.3",
    "dotenv": "^8.2.0",
    "eslint-config-airbnb-typescript": "^12.3.1",
    "eslint-config-prettier": "^8.2.0",
    "husky": "^6.0.0",
    "lint-staged": "^10.5.4",
    "prettier": "2.2.1",
    "ts-node": "^8.1.0",
    "typescript": "~3.9.7"
  },
  "dependencies": {
    "@aws-cdk/aws-apigateway": "1.87.0",
    "@aws-cdk/aws-codepipeline": "1.87.0",
    "@aws-cdk/aws-codepipeline-actions": "1.87.0",
    "@aws-cdk/aws-dynamodb": "1.87.0",
    "@aws-cdk/aws-elasticsearch": "1.87.0",
    "@aws-cdk/aws-iam": "1.87.0",
    "@aws-cdk/aws-lambda": "1.87.0",
    "@aws-cdk/aws-lambda-event-sources": "1.87.0",
    "@aws-cdk/core": "1.87.0",
    "@aws-cdk/pipelines": "1.87.0",
    "aws-sdk": "^2.884.0"
  }
}
